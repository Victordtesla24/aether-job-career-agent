// Aether Prisma schema — Phase 1 Foundation (Phase 2 portability tweak).
// The hosted PostgreSQL (Abacus.AI) does not ship the pgvector extension, so
// embeddings are stored as a portable `Float[]` (double precision[]) column.
// Similarity search runs in the matching pipeline (Python / sentence-transformers)
// with cosine similarity computed application-side; Pinecone remains the
// optional external vector store for large-scale retrieval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum JobStatus {
  discovered
  screening
  matched
  tailoring
  ready
  applied
  archived
  rejected
}

enum ApplicationStatus {
  draft
  submitted
  screening
  interview
  offer
  rejected
  withdrawn
}

enum ApprovalType {
  application_submit
  email_send
  offer_response
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ContactStage {
  identified
  contacted
  responded
  meeting
  referral
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Cache-busting SHA-256 hex of the profile photo bytes when present; never
  // a data URL. Raw bytes live in avatarFile (lazy DDL / migration 0033).
  image        String?
  // Profile photo bytes + sniffed content type (Settings → Profile upload).
  // Additive; nullable; no backfill — pre-existing rows honestly have none.
  avatarFile         Bytes?
  avatarContentType  String?
  // bcrypt hash for credentials auth (P2-S01). Nullable: OAuth-only users
  // have no local password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs             Job[]
  resumes          Resume[]
  applications     Application[]
  approvalRequests ApprovalRequest[]
  contacts         Contact[]
  emailThreads     EmailThread[]
  storyEntries     StoryEntry[]
  agentRuns        AgentRun[]
}

// ---------------------------------------------------------------------------
// Jobs + embeddings
// ---------------------------------------------------------------------------

model Job {
  id           String    @id @default(cuid())
  userId       String
  title        String
  company      String
  location     String?
  remote       Boolean   @default(false)
  salaryMin    Int?
  salaryMax    Int?
  currency     String?
  description  String
  requirements Json?
  source       String
  sourceUrl    String?
  status       JobStatus @default(discovered)
  fitScore     Float?
  atsScore     Float?
  saved        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding       JobEmbedding?
  applications    Application[]
  tailoredResumes Resume[]      @relation("JobTailoredResumes")

  // Idempotent discovery: the same posting (per user) is upserted, never
  // duplicated (P2-S02). NULL sourceUrls are exempt per SQL semantics.
  @@unique([userId, sourceUrl])
  @@index([userId])
  @@index([status])
}

model JobEmbedding {
  id        String   @id @default(cuid())
  jobId     String   @unique
  vector    Float[]
  model     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Resumes (versioned, tailored)
// ---------------------------------------------------------------------------

model Resume {
  id          String   @id @default(cuid())
  userId      String
  version     Int      @default(1)
  label       String?
  sections    Json
  sourceJobId String?
  parentId    String?
  formatHash  String
  // Human-in-the-loop review state (MV-resume-studio-001). Defaults to
  // "approved" so the immutable base and all pre-existing tailored versions stay
  // authoritative; a freshly tailored child version is created "pending" and
  // flips to "approved"/"rejected" when its ApprovalRequest is resolved. Added
  // additively via lazy DDL (app.db.ensure_resume_columns) — there is no
  // migration runner in this repo (ADR-TR-1).
  approvalStatus String @default("approved")
  // The user's uploaded document, kept EXACTLY as received (U2a / R-F1, mirrored
  // in apps/api/migrations/0027_resume_original_upload.sql). This is the
  // immutable baseline every tailoring run derives from, served back verbatim by
  // GET /resumes/{id}/original; formatHash is the full SHA-256 of these bytes.
  // Written once at upload and never updated. Nullable with no default and no
  // backfill: NULL means "no original stored" — every row predating this slice,
  // plus JSON-ingested and tailored versions, which genuinely have no file.
  // Added additively via lazy DDL (app.db.ensure_resume_columns); declared here
  // so a Prisma push never drops a column holding an unrecoverable user file.
  originalFile        Bytes?
  originalFilename    String?
  originalContentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceJob Job?     @relation("JobTailoredResumes", fields: [sourceJobId], references: [id])
  parent    Resume?  @relation("ResumeVersions", fields: [parentId], references: [id])
  children  Resume[] @relation("ResumeVersions")

  applications Application[]

  @@index([userId])
  @@index([userId, formatHash])
}

// ---------------------------------------------------------------------------
// Applications + approval gates
// ---------------------------------------------------------------------------

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  resumeId    String
  status      ApplicationStatus @default(draft)
  coverLetter String?
  answers     Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // U-AX submit-time snapshots (migration 0028). NULL means "not measured at
  // that submission" — the honest value for every row predating them, which is
  // why no backfill exists. Applied at runtime by
  // app.db.ensure_application_submission_snapshot_columns; declared here so a
  // Prisma push never drops them.
  atsScoreAtSubmission        Float?
  tailoredResumeVersionId     String?
  dimensionScoresAtSubmission Json?
  policyTierAtSubmission      String?

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume           Resume                   @relation(fields: [resumeId], references: [id])
  approvalRequests ApprovalRequest[]
  emailThreads     EmailThread[]
  statusEvents     ApplicationStatusEvent[]

  @@index([userId])
  @@index([jobId])
}

/// U-AX status-transition history (migration 0028). One row per OBSERVED
/// transition, written by every path that changes Application.status.
/// `fromStatus` is nullable and stays NULL when the prior status genuinely was
/// not observed — a guessed value would defeat the table's entire purpose.
/// `source` names the code path, and `'backfill:current-status'` marks the one
/// reconstructed genesis row per pre-existing application.
model ApplicationStatusEvent {
  id            String   @id
  seq           BigInt   @default(autoincrement())
  applicationId String
  fromStatus    String?
  toStatus      String
  at            DateTime @default(now())
  source        String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, at, seq])
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  userId        String
  applicationId String?
  type          ApprovalType
  status        ApprovalStatus @default(pending)
  payload       Json
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
  // Idempotency marker for /approvals/{id}/execute (MV-approval-modal-010):
  // stamped exactly once when the high-risk side-effect fires, so a retry/
  // double-submit cannot execute the same approval twice. Managed by lazy DDL
  // (ensure_approval_columns) — additive, nullable, backward compatible.
  executedAt    DateTime?
  // Decision attribution (GOLD-MASTER-V2 §15 Defect 1): who resolved this
  // request and from what client IP, persisted on the row itself so it
  // survives independent of AdminAuditLog / access-log rotation. Populated
  // by ApprovalRepository._resolve() alongside resolvedAt. Managed by lazy
  // DDL (ensure_approval_columns) — additive, nullable, backward compatible.
  resolvedByUserId String?
  resolvedFromIp   String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Networking + email
// ---------------------------------------------------------------------------

model Contact {
  id          String       @id @default(cuid())
  userId      String
  name        String
  title       String?
  company     String?
  stage       ContactStage @default(identified)
  email       String?
  linkedinUrl String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailThreads EmailThread[]

  @@index([userId])
}

model EmailThread {
  id             String   @id @default(cuid())
  userId         String
  applicationId  String?
  contactId      String?
  subject        String
  messages       Json
  classification String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Story bank + agent runs
// ---------------------------------------------------------------------------

model StoryEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  situation String
  task      String
  action    String
  result    String
  metrics   Json?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentRun {
  id          String         @id @default(cuid())
  userId      String
  agentName   String
  status      AgentRunStatus @default(queued)
  input       Json?
  output      Json?
  error       String?
  costUsd     Decimal?       @db.Decimal(10, 4)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  // CRITICAL-1: liveness stamp written every ~30s WHILE the run executes
  // (app/services/agent_run_watchdog.py). NULL means no worker ever proved it
  // was alive. The watchdog reconciles a 'running' row only when this evidence
  // is missing, so a legitimately long run is never reaped on age alone.
  heartbeatAt DateTime?
  // U-AX (migration 0028). What this run acted on, and the rigor policy it
  // obeyed. Plain nullable columns, NOT enforced FKs: runs legitimately exist
  // with no job (scout, storyExtractor), and a deleted job must never make a
  // historical audit row un-insertable. `policyTier` / `metricSnapshot` are
  // NULL on every run predating the policy loop — never back-stamped with
  // today's verdict.
  applicationId  String?
  jobId          String?
  policyTier     String?
  metricSnapshot Json?
  // B6 (migration 0029). The id of the AgentRun that CAUSED this one — e.g.
  // every step _pipeline_core dispatches carries the pipeline's supervisor
  // run's id, so the agents-console orchestration map can draw a real causal
  // edge instead of only the stage-order one. Plain nullable column, not an
  // enforced FK (same audit-row rule as jobId/applicationId above). NULL on
  // every run predating this column — never backfilled.
  parentRunId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([status, heartbeatAt])
  @@index([jobId])
  @@index([parentRunId])
}
