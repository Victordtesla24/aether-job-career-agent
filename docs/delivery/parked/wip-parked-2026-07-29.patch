@@ -782,6 +782,39 @@ def _execute_reserved_run(
         # so a no-op is refunded exactly once on either path, never twice.
         _refund_once()
         raise
+    except FabricationError as exc:
+        # GAP-P4-002: the cover agent's fabrication guard rejected the draft
+        # after every corrective retry — the guard WORKING is NOT a failure.
+        # ``FabricationError.__init__`` already prefixes the message with
+        # ``"Fabricated entities detected: <list>"``, so ``str(exc)`` is the
+        # entity list rendered into English — NEVER verbatim LLM output, zero
+        # PII risk. Record an honest COMPLETED degrade (mirroring the async
+        # worker at tasks.py:263-292) so the AgentRun audit table NEVER
+        # surfaces a fabricated entity as a red "failed" activity row. Refund
+        # the reserved run — no letter was produced — and re-raise so the
+        # caller's handler (``run_cover_letter`` → 422, ``_pipeline_core`` →
+        # degrade) keeps building its own response shape unchanged.
+        honest_output: dict[str, Any] = {
+            "cover_letter_id": None,
+            "coverLetterUnavailable": True,
+            "reason": str(exc.flagged),
+        }
+        runs.finish(run_id, "completed", output=honest_output, cost_usd=0.0)
+        _refund_once()
+        raise
+    except StructuralError as exc:
+        # Mirror of the FabricationError handler above: the structural guard
+        # rejecting a non-compliant letter is the guard WORKING. Record an
+        # honest COMPLETED degrade so the Activity feed never shows a
+        # fabricated or structurally-invalid entity as a red failure.
+        honest_output: dict[str, Any] = {
+            "cover_letter_id": None,
+            "coverLetterUnavailable": True,
+            "reason": str(exc.issues),
+        }
+        runs.finish(run_id, "completed", output=honest_output, cost_usd=0.0)
+        _refund_once()
+        raise
     except QuotaExhaustedError as exc:
         # Subscription quota exhausted mid-run — record honestly and 429.
         runs.finish(run_id, "failed", error=str(exc))
