+++ b/apps/api/app/services/dedup.py
@@ -69,3 +69,27 @@ def compute_null_source_url_hash(
 def compute_description_hash(description: str) -> str:
     normalized = description.strip()[:500]
     return hashlib.sha256(normalized.encode("utf-8")).hexdigest()
+
+
+def compute_story_content_hash(
+    user_id: str, title: str, situation: str, task: str,
+    action: str, result: str,
+) -> str:
+    """Content-based dedup hash for STAR stories.
+
+    Hashes (userId + title + situation + task + action + result) so that
+    re-running story extraction on the same résumé does not create duplicate
+    rows and to prevent manual create of identical stories from the REST API.
+
+    This mirrors ``compute_null_source_url_hash`` for jobs.  Tags and metrics
+    are intentionally excluded — they are decoration, not identity.
+    """
+    key = (
+        f"{user_id}|"
+        f"{title.strip().lower()}|"
+        f"{situation.strip().lower()}|"
+        f"{task.strip().lower()}|"
+        f"{action.strip().lower()}|"
+        f"{result.strip().lower()}"
+    )
+    return hashlib.sha256(key.encode("utf-8")).hexdigest()
