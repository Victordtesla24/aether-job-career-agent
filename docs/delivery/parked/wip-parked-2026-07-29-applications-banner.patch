   });
 });
+
+describe("Safety banner gate-OFF branch (WEB-4 / R-4)", () => {
+  it("renders the red 'Approval gate is OFF' warning when approvalGate is false", async () => {
+    apiRequest.mockImplementation(async (path: string) => {
+      if (path === "/applications") return [APP_FIXTURE];
+      if (path === "/jobs") return [];
+      if (path.startsWith("/approvals")) return [];
+      if (path === "/workspaces/settings") {
+        return { agentConfig: { autoApply: false, approvalGate: false, matchThreshold: 85 } };
+      }
+      throw new Error(`unexpected apiRequest(${path})`);
+    });
+
+    render(<ApplicationsPage />);
+    await screen.findByTestId("applications-kanban");
+
+    const banner = await screen.findByTestId("auto-apply-banner");
+    expect(banner.textContent).toContain("Approval gate is OFF");
+    expect(banner.textContent).toContain(
+      "generated proposals can be submitted without your review",
+    );
+    // Must not render the gate-ON reassurance copy.
+    expect(banner.textContent).not.toContain("Approval gate is on —");
+  });
+
+  it("also warns that auto-apply will submit without review when both auto-apply and gate-OFF are true", async () => {
+    apiRequest.mockImplementation(async (path: string) => {
+      if (path === "/applications") return [APP_FIXTURE];
+      if (path === "/jobs") return [];
+      if (path.startsWith("/approvals")) return [];
+      if (path === "/workspaces/settings") {
+        return { agentConfig: { autoApply: true, approvalGate: false, matchThreshold: 85 } };
+      }
+      throw new Error(`unexpected apiRequest(${path})`);
+    });
+
+    render(<ApplicationsPage />);
+    await screen.findByTestId("applications-kanban");
+
+    const banner = await screen.findByTestId("auto-apply-banner");
+    expect(banner.textContent).toContain("Approval gate is OFF");
+    expect(banner.textContent).toContain(
+      "Auto-apply is also on — agents will process AND submit",
+    );
+  });
+
+  it("renders the green gate-ON reassurance banner when approvalGate is true (control)", async () => {
+    defaultMock();
+    render(<ApplicationsPage />);
+    await screen.findByTestId("applications-kanban");
+
+    const banner = await screen.findByTestId("auto-apply-banner");
+    expect(banner.textContent).toContain("Approval gate is on —");
+    expect(banner.textContent).not.toContain("Approval gate is OFF");
+  });
+});
