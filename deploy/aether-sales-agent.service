# Native Sales AI Agent — one pipeline run (inbound polling, lifecycle nudges,
# LinkedIn drafts, daily digest), fired every 30 min by aether-sales-agent.timer.
#
# Install (from repo, kept in version control per convention):
#   sudo ln -sf /home/ubuntu/github_repos/aether-job-career-agent/deploy/aether-sales-agent.service /etc/systemd/system/aether-sales-agent.service
#   sudo ln -sf /home/ubuntu/github_repos/aether-job-career-agent/deploy/aether-sales-agent.timer   /etc/systemd/system/aether-sales-agent.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now aether-sales-agent.timer
#
# The run is IN-PROCESS (imports app.agents.sales_agent directly) — no HTTP,
# no login, no credentials beyond the repo .env the API itself loads. Feature
# flags (AETHER_SALES_AGENT_ENABLED / AETHER_SALES_AGENT_DRY_RUN) are read
# fresh each run, so flipping shadow mode needs no restart of anything.
[Unit]
Description=Aether Sales Agent (one scheduled pipeline run)
After=network-online.target aether-api.service
Wants=network-online.target
RequiresMountsFor=/home/ubuntu

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/github_repos/aether-job-career-agent
ExecStart=/opt/abacus-python/bin/python3 /home/ubuntu/github_repos/aether-job-career-agent/scripts/sales_agent_cron.py
TimeoutStartSec=900
