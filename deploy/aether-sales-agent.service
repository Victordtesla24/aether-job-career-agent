# Native Sales AI Agent — one pipeline run (inbound polling, lifecycle nudges,
# LinkedIn drafts, daily digest).
#
# HOSTINGER PRODUCTION: do NOT enable this unit. Scheduling is the ARQ cron
# `sales_agent_cron` on aether-prod-worker (minutes 15 and 45). Enabling this
# timer AND the ARQ cron would double-run the pipeline against the same inbox.
# These files stay in the repo as a disaster-recovery alternative.
#
# If you must run it as systemd (single scheduler only):
#   sudo ln -sf /root/prod/app/deploy/aether-sales-agent.service /etc/systemd/system/aether-sales-agent.service
#   sudo ln -sf /root/prod/app/deploy/aether-sales-agent.timer   /etc/systemd/system/aether-sales-agent.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now aether-sales-agent.timer
#
# Feature flags (AETHER_SALES_AGENT_ENABLED / AETHER_SALES_AGENT_DRY_RUN) are
# read fresh each run from the repo .env.
[Unit]
Description=Aether Sales Agent (one scheduled pipeline run)
After=network-online.target aether-prod-api.service
Wants=network-online.target
RequiresMountsFor=/root/prod/app

[Service]
Type=oneshot
WorkingDirectory=/root/prod/app
EnvironmentFile=/root/prod/app/.env
ExecStart=/root/prod/app/apps/api/.venv/bin/python /root/prod/app/scripts/sales_agent_cron.py
TimeoutStartSec=900
