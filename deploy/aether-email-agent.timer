# Fires aether-email-agent.service every 2 hours, jittered so it never
# ticks in perfect lockstep with aether-discovery.timer (every 30 minutes)
# or aether-backup.timer (every 6 hours) against the same API process.
# Install/disable instructions: see aether-email-agent.service header.
[Unit]
Description=Run Aether scheduled email agent every 2 hours

[Timer]
OnCalendar=*-*-* 00/2:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
