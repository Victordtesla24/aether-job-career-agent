# HOSTINGER: do not enable this timer. Production scheduling is ARQ
# sales_agent_cron on aether-prod-worker. This unit is disaster-recovery only.
# Enabling it alongside the ARQ cron would double-run the pipeline.
[Unit]
Description=Run the Aether Sales Agent every 30 minutes (do not enable alongside ARQ cron)

[Timer]
OnCalendar=*-*-* *:15/30
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
